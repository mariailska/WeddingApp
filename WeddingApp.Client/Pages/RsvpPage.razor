@page "/z/{token}/rsvp"
@layout Layout.EmptyLayout
@using WeddingApp.Shared.Enums
@using WeddingApp.Shared.DTOs
@inject WeddingApp.Client.Services.IInvitationService InvitationService
@inject NavigationManager NavManager

<div class="rsvp-container">
    @if (isLoading)
    {
        <p class="loading-text">Ładowanie formularza...</p>
    }
    else if (invitation == null)
    {
        <p>Błąd ładowania danych.</p>
    }
    else if (submitSuccess)
    {
        <div class="form-card success-card">
            <h2>Dziękujemy! 🤍</h2>
            <p>Wasza odpowiedź została pomyślnie zapisana.</p>
            <button class="submit-button" @onclick="GoBack">Wróć do zaproszenia</button>
        </div>
    }
    else
    {
        <button class="back-button" @onclick="GoBack">← Wróć do zaproszenia</button>
        
        <div class="form-card">
            <h2>Potwierdzenie przybycia</h2>
            <p class="subtitle">Szanowni @invitation.DisplayName</p>
            
            @if (invitation.Guests != null)
            {
                @foreach (var guest in invitation.Guests)
                {
                    <div class="guest-section">
                        <h3 class="guest-name">@guest.Name</h3>
                        
                        <div class="toggle-group">
                            <button class="toggle-btn @(guest.Attendance == AttendanceStatus.Present ? "active-yes" : "")"
                                    @onclick="() => guest.Attendance = AttendanceStatus.Present">
                                Będę z radością!
                            </button>
                            <button class="toggle-btn @(guest.Attendance == AttendanceStatus.NotPresent ? "active-no" : "")"
                                    @onclick="() => guest.Attendance = AttendanceStatus.NotPresent">
                                Niestety nie dotrę
                            </button>
                        </div>

                        @if (guest.Attendance == AttendanceStatus.Present)
                        {
                            <div class="diet-section">
                                <label>Wybierz preferencje kulinarne:</label>
                                <select class="diet-select" @bind="guest.Diet">
                                    <option value="@DietaryRequirement.Normal">Menu standardowe</option>
                                    <option value="@DietaryRequirement.Vegetarian">Wegetariańskie</option>
                                    <option value="@DietaryRequirement.Vegan">Wegańskie</option>
                                    <option value="@DietaryRequirement.GlutenFree">Bezglutenowe</option>
                                </select>
                            </div>
                        }
                    </div>
                }
            }

            <!-- POLE TEKSTOWE NA UWAGI -->
            <div class="notes-section">
                <label for="notes">Dodatkowe informacje dla nas (opcjonalnie):</label>
                <p class="notes-hint">Potrzeba noclegu, alergie, pytania...</p>
                <textarea id="notes" class="notes-input" @bind="invitation.Notes" rows="3" placeholder="Napisz tutaj..."></textarea>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="error-text">@errorMessage</p>
            }

            <button class="submit-button" disabled="@isSubmitting" @onclick="SubmitRsvp">
                @(isSubmitting ? "Zapisywanie..." : "Wyślij potwierdzenie")
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    private InvitationDto? invitation;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool submitSuccess = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        invitation = await InvitationService.GetInvitationAsync(Token);
        isLoading = false;
    }

    private void GoBack()
    {
        NavManager.NavigateTo($"/z/{Token}");
    }

    private async Task SubmitRsvp()
    {
        if (invitation == null) return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var updateDto = new UpdateInvitationDto
            {
                DisplayName = invitation.DisplayName,
                AccommodationDetails = invitation.AccommodationDetails, 
                Notes = invitation.Notes,
                Guests = invitation.Guests.Select(g => new UpdateGuestDto
                {
                    Name = $"{g.Name}",
                    Attendance = g.Attendance,
                    Diet = g.Diet
                }).ToList()
            };
            
            await InvitationService.UpdateInvitationAsync(Token, updateDto);
            
            submitSuccess = true;
        }
        catch (Exception ex)
        {
            errorMessage = "Wystąpił błąd podczas zapisywania. Spróbuj ponownie lub skontaktuj się z nami.";
            Console.WriteLine($"Błąd zapisu RSVP: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}